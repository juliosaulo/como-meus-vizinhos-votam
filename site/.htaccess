# Apache da HostGator. Vai na raiz do public_html, junto com index.html.

Options -Indexes
ErrorDocument 404 /404.html

# Nada de arquivo oculto pela web. O painel da hospedagem deixa cópias da
# configuração para trás (.htaccess.phpupgrader.*), e elas ficavam legíveis.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# As fontes são do card, desenhado no servidor: o navegador não precisa delas.
<FilesMatch "\.(ttf|otf)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Um endereço só: https e sem www.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://comomeusvizinhosvotam.com.br%{REQUEST_URI} [L,R=301]

  # Link compartilhado de um local de votação, e a imagem da prévia dele.
  # O identificador é {zona}-{local} do TSE; quem valida de novo é o PHP.
  RewriteRule ^l/([0-9]{7})/([0-9]{1,4}-[0-9]{1,5})/?$ l.php?m=$1&i=$2 [L,QSA]
  RewriteRule ^card/([0-9]{7})/([0-9]{1,4}-[0-9]{1,5})\.png$ card.php?m=$1&i=$2 [L]
</IfModule>

AddType application/json .json
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddType font/woff .woff
AddDefaultCharset utf-8
AddCharset utf-8 .json .js .css .webmanifest

# Compressão: os JSON de município grande passam de 10 MB e caem para uma fração.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml image/x-icon
</IfModule>

<IfModule mod_headers.c>
  # HTML, JS e CSS revalidam sempre: os módulos JS se importam sem número de
  # versão, e uma atualização do site precisa chegar a quem já visitou.
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Dados: um ano. O site pede cada JSON com a versão da publicação na URL
  # (ver js/dados.js), então dado novo é sempre um endereço novo.
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Menos este: é ele que carrega a versão, e por isso não pode ficar guardado.
  <Files "metadados.json">
    Header set Cache-Control "no-cache"
  </Files>
  # Imagens e fontes: uma semana.
  <FilesMatch "\.(png|jpe?g|webp|gif|ico|svg|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  # Só o próprio domínio, o Leaflet no cdnjs e os tiles da Stadia. 'unsafe-inline'
  # em estilos porque as barras recebem a largura por atributo style.
  # `connect-src` inclui o servidor de resultados do TSE: é de lá que o navegador
  # busca os boletins de urna do local em exibição, durante a apuração.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: https://tiles.stadiamaps.com https://cdnjs.cloudflare.com; connect-src 'self' https://resultados.tse.jus.br; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
